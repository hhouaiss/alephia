{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "build": {
    "env": {
      "NODE_OPTIONS": "--max_old_space_size=4096 --max-http-header-size=81920"
    }
  },
  "redirects": [
    { "source": "/automatisation-ia/artisan", "destination": "/formation-ia/artisans", "permanent": true },
    { "source": "/automatisation-ia/agence-communication", "destination": "/formation-ia/agences-communication", "permanent": true },
    { "source": "/automatisation-ia/cabinet-comptable", "destination": "/formation-ia/cabinets-comptables", "permanent": true },
    { "source": "/automatisation-ia/e-commerce", "destination": "/formation-ia/e-commerce", "permanent": true },
    { "source": "/automatisation-ia/coach-consultant", "destination": "/formation-ia/coachs-consultants", "permanent": true },
    { "source": "/automatiser/devis", "destination": "/formation-ia/devis", "permanent": true },
    { "source": "/automatiser/relances-clients", "destination": "/formation-ia/relances-clients", "permanent": true },
    { "source": "/automatiser/gestion-emails", "destination": "/formation-ia/emails", "permanent": true },
    { "source": "/automatiser/reporting", "destination": "/formation-ia/reporting", "permanent": true },
    { "source": "/automatiser/saisie-donnees", "destination": "/formation-ia/extraction-donnees", "permanent": true },
    { "source": "/automatiser/suivi-prospects", "destination": "/formation-ia/prospection", "permanent": true },
    { "source": "/automatiser/onboarding-client", "destination": "/formation-ia/onboarding-client", "permanent": true },
    { "source": "/automatisation-ia", "destination": "/formation-ia", "permanent": true },
    { "source": "/automatisation-ia/:path*", "destination": "/formation-ia", "permanent": true },
    { "source": "/automatiser", "destination": "/formation-ia", "permanent": true },
    { "source": "/automatiser/:path*", "destination": "/formation-ia", "permanent": true },
    { "source": "/blog", "destination": "/", "permanent": true },
    { "source": "/blog/:path*", "destination": "/", "permanent": true },
    { "source": "/services", "destination": "/", "permanent": true },
    { "source": "/services/:path*", "destination": "/", "permanent": true },
    { "source": "/solutions", "destination": "/", "permanent": true },
    { "source": "/agence-ia-paris", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/", "permanent": true },
    { "source": "/contact", "destination": "/", "permanent": true },
    { "source": "/demos", "destination": "/", "permanent": true },
    { "source": "/careers", "destination": "/", "permanent": true },
    { "source": "/new-landing", "destination": "/", "permanent": true },
    { "source": "/new-landing-1", "destination": "/", "permanent": true },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|svg|webp|avif|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
