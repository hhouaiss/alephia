---
// Formulaire "Démarrer mon projet" (section #demande), POST /api/projet.
// Les liens [data-formula="express|business"] de la page pré-sélectionnent la formule.
import { FORMULA_CHOICES } from '../../lib/siteLead';
import { CONTACT_EMAIL } from '../../data/offer';
import { EXPRESS, BUSINESS } from '../../data/studio';

const formulaHint: Record<string, string> = {
  express: `One-page · dès\u00a0${EXPRESS.price}\u00a0HT`,
  business: `Jusqu’à 5\u00a0pages · dès\u00a0${BUSINESS.price}\u00a0HT`,
  unsure: 'On vous conseille',
};
---

<section id="demande" class="nl-section nl-blue nl-anchor">
  <div class="nl-wrap nl-funnel-grid">
    <div class="nl-funnel-intro">
      <p class="nl-kicker">Démarrer mon projet</p>
      <h2 class="nl-h2">Votre prochain site web commence ici.</h2>
      <p class="nl-funnel-lead">Expliquez-nous votre projet. Nous vous orientons vers la formule adaptée à votre activité.</p>
      <ol class="nl-next">
        <li><strong>Nous vous rappelons sous 24 h ouvrées.</strong> Un court échange pour comprendre votre activité.</li>
        <li><strong>Vous validez la formule et le prix.</strong> Tout est clair avant de commencer.</li>
        <li><strong>Nous créons votre site.</strong> Première version, ajustements, mise en ligne.</li>
      </ol>
    </div>

    <div class="nl-funnel">
      <form id="pj-form" novalidate>
        <fieldset class="nl-step">
          <legend class="nl-q st-form-q">Quelle formule vous intéresse ?</legend>
          <div class="nl-choices st-formulas" role="radiogroup" aria-describedby="pj-formula-err">
            {FORMULA_CHOICES.map((c) => (
              <label class="nl-choice st-formula">
                <input type="radio" name="formula" value={c.value} />
                <span><strong>{c.label}</strong><small>{formulaHint[c.value]}</small></span>
              </label>
            ))}
          </div>
          <p id="pj-formula-err" class="nl-error" data-error-for="formula" hidden></p>
        </fieldset>

        <div class="nl-fields st-form-fields">
          <div class="nl-field">
            <label for="pj-fullName">Prénom et nom</label>
            <input id="pj-fullName" name="fullName" type="text" autocomplete="name" aria-describedby="pj-fullName-err" />
            <p id="pj-fullName-err" class="nl-error" data-error-for="fullName" hidden></p>
          </div>
          <div class="nl-field">
            <label for="pj-company">Entreprise</label>
            <input id="pj-company" name="company" type="text" autocomplete="organization" aria-describedby="pj-company-err" />
            <p id="pj-company-err" class="nl-error" data-error-for="company" hidden></p>
          </div>
          <div class="nl-field">
            <label for="pj-email">Email</label>
            <input id="pj-email" name="email" type="email" autocomplete="email" inputmode="email" aria-describedby="pj-email-err" />
            <p id="pj-email-err" class="nl-error" data-error-for="email" hidden></p>
          </div>
          <div class="nl-field">
            <label for="pj-phone">Téléphone</label>
            <input id="pj-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="06 12 34 56 78" aria-describedby="pj-phone-err" />
            <p id="pj-phone-err" class="nl-error" data-error-for="phone" hidden></p>
          </div>
          <div class="nl-field nl-span-2">
            <label for="pj-activity">Votre activité</label>
            <input id="pj-activity" name="activity" type="text" placeholder="Ex. : plombier, fleuriste, cabinet de conseil" aria-describedby="pj-activity-err" />
            <p id="pj-activity-err" class="nl-error" data-error-for="activity" hidden></p>
          </div>
          <div class="nl-field nl-span-2">
            <label for="pj-details">Quelques précisions sur votre projet <span class="nl-opt">(facultatif)</span></label>
            <textarea id="pj-details" name="details" rows="3" placeholder="Ex. : j’ai déjà un logo, je voudrais un site pour être trouvé dans ma ville"></textarea>
          </div>
          <div class="nl-span-2">
            <label class="nl-check" for="pj-consent">
              <input id="pj-consent" name="consent" type="checkbox" aria-describedby="pj-consent-err" />
              <span>J’accepte d’être recontacté au sujet de ma demande. <a href="/privacy" target="_blank" rel="noopener">Confidentialité</a></span>
            </label>
            <p id="pj-consent-err" class="nl-error" data-error-for="consent" hidden></p>
          </div>
        </div>

        <!-- Champ piège anti-spam : invisible pour les humains -->
        <div class="nl-hp" aria-hidden="true">
          <label for="pj-fax">Ne pas remplir</label>
          <input id="pj-fax" name="fax_hp" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" id="pj-submit" class="nl-btn nl-btn-full">Démarrer mon projet <span aria-hidden="true">→</span></button>
        <p id="pj-global-error" class="nl-error" role="alert" hidden></p>
        <p class="nl-hint nl-center">Sans engagement. Réponse sous 24 h ouvrées.</p>
        <p class="nl-rgpd">
          Les informations saisies sont traitées par Alefia, sur la base de votre consentement, pour répondre à votre demande. Elles ne sont ni vendues ni cédées.
          Vous pouvez y accéder, les rectifier, les supprimer ou retirer votre accord en écrivant à <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
          Vous pouvez aussi saisir la CNIL. <a href="/privacy" target="_blank" rel="noopener">Politique de confidentialité</a>
        </p>
      </form>

      <div id="pj-confirm" class="nl-confirm st-confirm" tabindex="-1" hidden>
        <span class="st-confirm-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
        </span>
        <p class="nl-q" role="status">Merci, votre demande est bien reçue.</p>
        <p>Nous vous rappelons sous 24 h ouvrées. Un email de confirmation vient de vous être envoyé.</p>
        <p>Pour gagner du temps, vous pouvez déjà rassembler votre logo, quelques photos et la liste de vos services.</p>
        <p class="nl-hint">Une question ? <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
      </div>
    </div>
  </div>
</section>

<script>
  import { SITE_FIELD_ORDER, parseSiteLead, validateSiteLead } from '../../lib/siteLead';
  import type { SiteLeadField } from '../../lib/siteLead';
  import { track } from '../../lib/track';

  const UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  const startedAt = Date.now();

  const storage = {
    get: (key: string) => { try { return sessionStorage.getItem(key); } catch { return null; } },
    set: (key: string, value: string) => { try { sessionStorage.setItem(key, value); } catch { /* stockage indisponible */ } },
  };

  const params = new URLSearchParams(window.location.search);
  UTM_KEYS.forEach((key) => {
    const value = params.get(key);
    if (value) storage.set(key, value);
  });

  const form = document.getElementById('pj-form') as HTMLFormElement | null;
  const confirmEl = document.getElementById('pj-confirm');
  const submitBtn = document.getElementById('pj-submit') as HTMLButtonElement | null;
  const globalError = document.getElementById('pj-global-error');

  if (form) {
    const selectFormula = (value: string) => {
      const radio = form.querySelector<HTMLInputElement>(`input[name="formula"][value="${value}"]`);
      if (radio) { radio.checked = true; radio.dispatchEvent(new Event('change', { bubbles: true })); }
    };

    // Lien ?formule=express|business dans l'URL (campagnes) ou bouton d'une carte tarifaire
    const fromUrl = params.get('formule');
    if (fromUrl) selectFormula(fromUrl);
    document.querySelectorAll<HTMLElement>('[data-formula]').forEach((el) => {
      el.addEventListener('click', () => {
        selectFormula(el.dataset.formula ?? '');
        track('formula_select', { event_category: 'funnel', formula: el.dataset.formula });
        // Une fois arrivé au formulaire, le curseur est dans le premier champ
        window.setTimeout(() => document.getElementById('pj-fullName')?.focus({ preventScroll: true }), 700);
      });
    });

    const buildRaw = () => {
      const fd = new FormData(form);
      return {
        formula: fd.get('formula') ?? '',
        fullName: fd.get('fullName'),
        company: fd.get('company'),
        email: fd.get('email'),
        phone: fd.get('phone'),
        activity: fd.get('activity'),
        details: fd.get('details'),
        consent: fd.get('consent') === 'on',
        fax_hp: fd.get('fax_hp'),
      } as Record<string, unknown>;
    };

    const setError = (name: SiteLeadField, message?: string) => {
      const errorEl = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (errorEl) { errorEl.textContent = message ?? ''; errorEl.hidden = !message; }
      const targets = name === 'formula'
        ? Array.from(form.querySelectorAll<HTMLElement>('input[name="formula"]'))
        : [form.elements.namedItem(name) as HTMLElement | null].filter(Boolean) as HTMLElement[];
      targets.forEach((field) => {
        if (message) field.setAttribute('aria-invalid', 'true');
        else field.removeAttribute('aria-invalid');
      });
    };

    const firstInput = (name: SiteLeadField) =>
      name === 'formula'
        ? form.querySelector<HTMLElement>('input[name="formula"]')
        : (form.elements.namedItem(name) as HTMLElement | null);

    const applyErrors = (errors: Partial<Record<SiteLeadField, string>>) => {
      SITE_FIELD_ORDER.forEach((name) => setError(name, errors[name]));
      const first = SITE_FIELD_ORDER.find((name) => errors[name]);
      if (first) firstInput(first)?.focus?.();
      return Boolean(first);
    };

    const revalidate = (event: Event) => {
      const target = event.target as HTMLInputElement;
      if (target.getAttribute('aria-invalid') !== 'true') return;
      const name = target.name as SiteLeadField;
      setError(name, validateSiteLead(parseSiteLead(buildRaw()))[name]);
    };
    form.addEventListener('input', revalidate);
    form.addEventListener('change', revalidate);

    let started = false;
    form.addEventListener('focusin', () => {
      if (started) return;
      started = true;
      track('form_start', { event_category: 'funnel' });
    });

    const showConfirmation = () => {
      form.hidden = true;
      if (confirmEl) { confirmEl.hidden = false; confirmEl.focus(); }
      document.getElementById('demande')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (globalError) globalError.hidden = true;

      const raw = buildRaw();
      if (raw.fax_hp) { showConfirmation(); return; }

      const lead = parseSiteLead(raw);
      if (applyErrors(validateSiteLead(lead))) {
        track('form_validation_error', { event_category: 'funnel' });
        return;
      }

      const payload: Record<string, unknown> = { ...lead, fax_hp: '', elapsedMs: Date.now() - startedAt, sourcePage: window.location.pathname };
      UTM_KEYS.forEach((key) => {
        const value = storage.get(key);
        if (value) payload[key] = value;
      });

      const defaultLabel = submitBtn?.innerHTML ?? '';
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Envoi en cours…'; }

      try {
        const res = await fetch('/api/projet', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.status === 400) {
          const body = await res.json().catch(() => ({}));
          if (body.errors && applyErrors(body.errors)) {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = defaultLabel; }
            return;
          }
        }
        if (!res.ok) throw new Error(`status ${res.status}`);

        track('site_form_submitted', { event_category: 'lead', event_label: 'site_web', formula: lead.formula });
        showConfirmation();
      } catch (err) {
        console.error('Project submit error:', err);
        if (globalError) {
          globalError.textContent = 'Une erreur est survenue. Réessayez ou écrivez-nous à hassan@alefia.co.';
          globalError.hidden = false;
        }
        if (submitBtn) { submitBtn.disabled = false; submitBtn.innerHTML = defaultLabel; }
      }
    });
  }
</script>
